  <link rel="stylesheet" href="r/sfdw/files/static/v273/themes/epa_theme/css/epa_styles_2022.css" type="text/css" />
<style type="text/css">
#dab_MenuNav {
	--dab-menu-active-bkg-clr: #1b1f24;
	--dab-mobile-submenu-txt-clr: #1b1f24;
	--dab-mobile-submenu-bkg-clr: #edeff0;
	--dab-submenu-clr: #1b1f24;
	background-color: var(--a-menubar-background-color);
}

.menu--main .menu__subnav {z-index: 999;}
.t-Header-nav {z-index: 20;}
.js-fullscreen-btn{z-index: 0 !important;}
#dab_MenuNav :focus {outline-offset: -1px;}
#dab_MenuNav .dab-menuNav__child[aria-hidden="true"] {display: none;}
#dab_MenuNav .dab-menuNav__child[aria-hidden="false"] {display: block;}
#dab_MenuNav ul { list-style: none;}
#dab_MenuNav > ul > li[aria-expanded="true"] > a {background-color: var(--dab-menu-active-bkg-clr);}
#dab_MenuNav > ul > li > a {color: #fff;}
#dab_MenuNav > ul > li > ul > li > ul > li > a {font-weight: bold;}
#dab_MenuNav > ul > li > ul > li > ul > li:first-child {padding-left: 0;}
#dab_MenuNav > ul > li > ul > li > ul > li > ul {margin: 0 20px;}
#dab_MenuNav ul ul > li > a {color: var(--dab-mobile-submenu-txt-clr);}

#dab_MenuNav > ul > li[data-current="true"] > a {
	background-color: var(--dab-menu-active-bkg-clr);
	font-weight: bold;
}

#dab_MenuNav > ul {
	display: flex;
	flex-flow: row wrap;
	max-width: 64rem;
	margin: 12px auto;
	padding: 0 1.5rem;
}

#dab_MenuNav > ul > li {
	display: flex;
	cursor: pointer;
	flex: 1 0 100%;
	flex-flow: row wrap;
}

#dab_MenuNav > ul > li > ul > li {
	max-width: 75rem;
	margin: 0 auto;
}

#dab_MenuNav ul ul ul {margin-top: 0;}
#dab_MenuNav ul li a {
	align-items: center;
	color: #fff;
	display: flex;
	justify-content: space-between;
	font-size: 14px;
	padding: 1rem 1.5rem;
	flex-grow: 1;
}

#dab_MenuNav .dab--has-subMenu:after {
	background: url(/ords/sfdw_rest/r/sfdw/files/static/v351/themes/epa_theme/images/main-menu-arrow.svg) no-repeat 50% 50%;
	color: #fff;
	content: "";
	display: inline-block;
	height: 0.85em;
	margin-left: 0.5rem;
	width: 0.85em;
	transform: rotate(-180deg);
	transition: transform 375ms cubic-bezier(0, 0, 0.2, 1);
}

#dab_MenuNav .dab_MenuNav__nav-item[aria-expanded="true"] .dab--has-subMenu:after {
	transform: rotate(-1deg);
	transition: transform 375ms cubic-bezier(0, 0, 0.2, 1);
}

#dab_MenuNav > ul > li:hover > a {
	background-color: var(--dab-menu-active-bkg-clr);
	transition: 0.2s;
}

#dab_MenuNav ul li ul a:hover {text-decoration: underline;}
#dab_MenuNav > ul > li > ul.dab-menuNav__child {
	background-color: var(--dab-mobile-submenu-bkg-clr);
	left: 0;
	margin: 0;
	position: relative;
	width: 100%;
	z-index: 999;
}

#dab_MenuNav ul ul ul li a {padding: 5px 20px;}
#dab_MenuNav > ul > li > ul > li > ul {
	display: flex;
	flex-flow: column nowrap;
	margin: 0 0 12px 0;
}

#dab_MenuNav > ul > li > ul > li > a {
	font-size: 18px;
	display: block;
	padding-left: 20px;
	width: 100%;
}

#dab_MenuNav > ul > li > ul > li > a:after {
	background: var(--dab-menu-active-bkg-clr);
	content: "";
	display: block;
	height: 2px;
	margin-bottom: 5px;
}

@media screen and (min-width: 1024px) {
	#dab_MenuNav > ul {flex-flow: row nowrap;}
	#dab_MenuNav > ul > li { flex: 0 0 auto; }
	#dab_MenuNav > ul > li > ul > li > ul {flex-direction: row;}
	#dab_MenuNav ul ul > li > a {color: #fff;}
	#dab_MenuNav > ul > li > ul > li > a:after { background: #fff; }
	#dab_MenuNav > ul > li > ul.dab-menuNav__child {
			background-color: var(--dab-submenu-clr);
			margin: 0;
			position: absolute;
			padding-left: 33px;
			top: 65px;
	}
}

@media screen and (min-width: 512px) {
	#dab_MenuNav ul li a {flex-grow: 0;}
}
</style>

