<script type="text/javascript">
apex.jQuery( function() {
apex.page.init( this, function() {
try {
(function(){dwdab_init();

function dwdab_init() {
	dwdab_add_classes_to_main_nav();
	dwdab_add_active_style_to_parent('dab_MenuNav__nav-item');
	dwdab_style_nav_items_with_submenu();
	dwdab_setNonLinkMenuAttrs();
	dwdab_addGlobalEventListeners();
	dwdab_showMenu();
}

function dwdab_setNonLinkMenuAttrs() {
	const non_link_menu_items = Array.from(document.querySelectorAll("#dab_MenuNav a"))
											.filter(link => link.getAttribute('href') == "");
	non_link_menu_items.forEach(item => {
		item.href = "javascript:void(0)";
	
		//Removes underline hover style from non link elements
		item.addEventListener('mouseenter', function(e){
			e.target.style.textDecoration = 'none';
		});
	});
}

function dwdab_addGlobalEventListeners() {
	document.addEventListener('click', dwdab_menuHandler);
	document.addEventListener('keydown', dwdab_menuHandler,);
}

function dwdab_showMenu() {
	const menu = document.getElementById("dab_MenuNav");
	menu.style.display = 'block'; 
}

function dwdab_style_nav_items_with_submenu() {
	const menu_main_items_with_children = Array.from(document.querySelectorAll("#dab_MenuNav > ul > li > a"))
											.filter(link => link.getAttribute('href') == "");
	menu_main_items_with_children.forEach(item => {
		item.classList.add('dab--has-subMenu')
		item.nextElementSibling.setAttribute('aria-hidden', true);
	})
}

function dwdab_add_classes_to_main_nav(){
	const main_menu_items = document.querySelectorAll("#dab_MenuNav > ul > li");
	main_menu_items.forEach(item => {
		item.classList.add('dab_MenuNav__nav-item');
	})
}

function dwdab_add_active_style_to_parent(classToCheckFor) {
	const active_nav_item = document.querySelector("#dab_MenuNav li[data-current=true]") || document.querySelector("#dab_MenuNav li");
	let i = 20;
	if (!active_nav_item.classList.contains('dab_MenuNav__nav-item')){
		let parent_active_nav_item = active_nav_item.parentNode;

		while( !parent_active_nav_item.classList.contains(classToCheckFor) || i < 1) {
			parent_active_nav_item = parent_active_nav_item.parentNode;
			i--;
		}
		parent_active_nav_item.dataset.current = true;
	}
}

function dwdab_menuHandler(e) {
	const navLI = e.target.closest('.dab_MenuNav__nav-item');
	const isClickSpaceOrEnter = e.type == "click" || (e.type == "keydown" && (e.code == "Space" || e.code == "Enter"));
	const openMenu = document.querySelector("#dab_MenuNav > ul > li[aria-expanded='true']");
	const isClickedOutsideMenu = !e.target.closest("#dab_MenuNav") && openMenu;

	if (navLI && isClickSpaceOrEnter) { dwdab_toggleMenu(e, navLI);}
	if (isClickedOutsideMenu && openMenu.querySelector('.dab-menuNav__child')) { dwdab_closeMenu(e, openMenu)} 
}

function dwdab_toggleMenu(e, navLI){
	const hasSubMenu = navLI.querySelectorAll('.dab-menuNav__child').length > 0;
	const targetisOutsideMenu = !e.target.classList.contains('dab-menuNav__child') && !e.target.closest('.dab-menuNav__child');
	const menuIsOpen = dwdab_checkMenuOpen(navLI.getAttribute('aria-expanded'));

	//Toggle menu display on nav item click
	if (!menuIsOpen && hasSubMenu){ dwdab_openMenu(e, navLI) } 
	if (menuIsOpen && hasSubMenu && targetisOutsideMenu) { dwdab_closeMenu(e, navLI) }
}

const dwdab_checkMenuOpen = (attr) => attr == "true" ? true : false;

function dwdab_closeMenu(e, menuEl) {
	e.preventDefault();
	menuEl.querySelector('.dab-menuNav__child').setAttribute('aria-hidden', true);
	menuEl.setAttribute('aria-expanded', false);
}

function dwdab_openMenu(e, menuEl){
	e.preventDefault();
	menuEl.querySelector('.dab-menuNav__child').setAttribute('aria-hidden', false);
	menuEl.setAttribute('aria-expanded', true);
}})();
(function(){apex.widget.selectList("#P30_YEAR_END",{"ajaxIdentifier":"SVRFTSBUWVBFfjUxMjB-NDY1Njc4MjI2NTA0NDM1ODA3Ng\u002FCwRgiSMoxUE7SIaEzYVehdkUPFg-f6Fx9necrCJPery8DXtgO3wiseHlx9t7YcURHAQK3Z-TFbvk95dMxb2YTA"});})();
(function(){apex.widget.yesNo("P30_ADVANCED_FILTERS","SWITCH_CB");})();
(function(){apex.widget.selectList("#P30_STATE",{"nullValue":"","ajaxIdentifier":"SVRFTSBUWVBFfjUxMjB-NDY1Njc4MjYyNDY4MTM1ODA4Mg\u002FWsXmDYLpIRbwCldV4dJa7q45j4-VQ0--oIf8l5B0bIXetuwBtnQD7a8h3US_iwt2eCiA0gVWKpOdZjtsgMHXOw"});})();
(function(){apex.jQuery('#AnnualReport_DW_Main_ir').interactiveReport({"regionId":"AnnualReport_DW_Main","columnSearch":false,"rowsPerPageSelect":true,"reportsSelect":false,"filter":false,"rowsPerPage":false,"currentRowsPerPage":100000,"maxRowCount":"1000","compute":false,"aggregate":false,"chart":false,"groupBy":false,"pivot":false,"flashback":false,"saveReport":false,"reset":false,"help":false,"download":false,"subscription":false,"pagination":false,"pageItems":"#P30_STATE,#P30_YEAR_END","lazyLoading":true,"ajaxIdentifier":"UkVHSU9OIFRZUEV-fjQ1OTM4MTAwMTgwODM4MzEwMTY\u002F3azYyCH7GhGSPVgR-JZllW7m0FLdPGiDArBsmwrfkW6Vw4_7uhOzufY3a-noNUrzMVL88D728NAUp6yFkYMRAQ"});})();
} catch(e) {apex.debug.error(e)};
apex.item.waitForDelayLoadItems().done(function() {
try {
(function(){apex.da.initDaEventList();
apex.da.init();})();
apex.theme42.initializePage.noSideCol();
var e = apex.jQuery("#t_MenuNav", apex.gPageContext$);
if (e.hasClass("js-addActions")) {
  apex.actions.addFromMarkup( e );
}
e.menu({
  behaveLikeTabs: e.hasClass("js-tabLike"),
  menubarShowSubMenuIcon: e.hasClass("js-showSubMenuIcons") || null,
  menubar: true,
  menubarOverflow: true,
  callout: e.hasClass("js-menu-callout")
});
 
//document.getElementsByClassName("a-IRR-header--group")[2].innerHTML = document.getElementsByClassName("a-IRR-header--group")[2].innerHTML.replace(". : ", "")

//updateIRControlBreak();
// $("").stickyWidget({toggleWidth:true});

apex.page.warnOnUnsavedChanges();
} finally {
apex.event.trigger(apex.gPageContext$,'apexreadyend');
};
});
});
});apex.pwa.cleanup( { serviceWorkerPath:'\u002Fords\u002Fsfdw_pub\u002Fr\u002Fsfdw\u002Fowsrf_public\u002Fsw.js?v=24.1.5-13412285056884\u0026lang=en' } );
